# API base path. Production: same-origin `/api/v1` (Nginx proxies to backend).
# Dev: defaults to http://localhost:3000/api/v1 if unset; Vite proxies `/api` to :3000.
VITE_BASE_BACK_URL=/api/v1

# NoroChat model API — separate base URL, do NOT use for other endpoints.
VITE_NORO_BASE_URL=http://72.60.47.186/model-api
VITE_NORO_API_KEY=your_noro_api_key_here
